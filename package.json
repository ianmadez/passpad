{
  "name": "passpad",
  "version": "0.2.0",
  "private": true,
  "description": "Pass the pad: share your PS5 with 1-4 friends over Tailscale, right in the browser. The host stays in charge.",
  "homepage": "https://github.com/ianmadez/passpad",
  "license": "MIT",
  "author": "gtalab (https://gtalab.dev)",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test ./test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "video": "vendor/mediamtx/mediamtx.exe mediamtx/mediamtx.yml"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/ws": "8.18.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.5"
}
