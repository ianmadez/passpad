# PassPad settings. START-PassPad.cmd writes the real file (config\host.env) for you;
# this is only a reference. Docs: docs/configuration.md

# --- Who may connect (Tailscale IPs, "tailscale ip -4" on each laptop) ---
HOST_TAILSCALE_IP=100.64.0.1
GUESTS=100.64.0.2           # up to 4, comma-separated; people type their own names on the page

# --- PS5 ---
CONSOLE=chiaki                 # or simulated (no PS5 needed, for testing)
PS5_HOST_IP=192.168.1.50       # the PS5's address on the home network

# --- Stream quality (720p is the automatic fallback) ---
STREAM_RESOLUTION=1080p        # or 720p
STREAM_BITRATE_1080P=15000     # kbit/s
STREAM_BITRATE=7000            # kbit/s at 720p

# --- Internals (the starter generates the password) ---
# PORT=3000
# MEDIAMTX_API_USER=passpad-api
# MEDIAMTX_API_PASS=generated-by-the-starter
